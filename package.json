{
  "name": "bulls-and-cows",
  "version": "1.0.0",
  "description": "Bulls and Cows game in functional TypeScript",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "serve public",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm test && npm run build && gh-pages -d public --nojekyll",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{html,css,json,md}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaluk/Bulls-and-Cows.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/isaluk/Bulls-and-Cows/issues"
  },
  "homepage": "https://github.com/isaluk/Bulls-and-Cows#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
